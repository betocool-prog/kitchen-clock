# secrets.env.example
#
# Copy to secrets.env and replace each placeholder with a value
# appropriate for your deployment. secrets.env is gitignored.
# Run `scripts/build-sd-bundle.sh` after every edit.

# --- Wi-Fi ---
WIFI_SSID="YOUR-SSID"
WIFI_PSK_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
WIFI_COUNTRY="AU"

# --- Host ---
HOSTNAME="kclock"

# --- Networking (static IPv4 on wlan0) ---
STATIC_IP="192.168.0.49/24"
GATEWAY="192.168.0.1"
DNS_SERVERS="192.168.0.1;1.1.1.1"

# --- Locale / timezone ---
LOCALE_PRIMARY="en_AU.UTF-8"
LOCALE_SECONDARY="en_AU.ISO-8859-1"
TIMEZONE="Australia/Perth"

# --- Linux user (created on Pi first boot) ---
USER_NAME="username"

# Get a hash with:
#   openssl passwd -6 -salt "$(openssl rand -hex 8)" 'your-plaintext-here'
USER_PASS_HASH='$6$<salt>$<SHA-512-crypt-hash>'

# --- SSH key (a single line; quoted) ---
SSH_PUBKEY="ssh-ed25519 AAAA... yourname@yourhost"
