/*
 * Overlay for the Seeed XIAO nRF52840 (board name `xiao_ble`).
 *
 * Three things this overlay does:
 *   1. re-targets the Zephyr printk console from the on-board USB-CDC
 *      to the XIAO's external UART0 pads (P1.11 TX, P1.12 RX).
 *      The host-side adapter is a plain 3.3 V USB-serial dongle
 *      (FTDI / CP2102 / CH340) — see docs/decisions/0004-debug-link.md.
 *   2. enables the BME280 via the bme280_i2c alias on &i2c1.
 *   3. leaves the on-board LEDs (`led0` = P0.26 "Red LED",
 *      `led1` = P0.30 "Green LED", `led2` = P0.06 "Blue LED") at
 *      their board-default settings — we reuse led0 for the bring-up
 *      heartbeat in src/blinky.c.
 *
 * The board DTS already provides pinctrl-0 entries for uart0 (TX on
 * P1.11, RX on P1.12), so we just need to drive &uart0 status="okay".
 */

/ {
    aliases {
        bme280 = &bme280_i2c;
    };

    chosen {
        zephyr,console      = &uart0;
        zephyr,shell-uart   = &uart0;
        /* Keep the BLE-controller transport over USB-CDC so we can
         * later run HCI traces / mcumgr without disturbing the
         * external UART debug stream.
         */
        zephyr,bt-c2h-uart  = &usb_cdc_acm_uart;
    };

    /* Battery-rail ADC channel selection: AIN7 on P0.31. The XIAO
     * nRF52840 connector maps this to the D7 pad (also called A7).
     * The actual adc-channel definition lives inside `&adc { … }`
     * below; here we just expose it as the application's
     * `zephyr,user` channel so the DT helper picks it up at compile
     * time.
     */
    zephyr,user {
        io-channels = <&adc 7>;
    };
};

&i2c1 {
    status = "okay";
    /* 0x77: SDO is the high input on the Adafruit BME280 STEMMA QT
     * breakout we use. On that breakout SDO is pulled up by an
     * on-board resistor when the address-select jumper is left
     * open (the default). If a project's jumper is bridged to GND,
     * reg must drop to <0x76>.
     */
    bme280_i2c: bme280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
    };
};

&uart0 {
    status = "okay";
    pinctrl-0     = <&uart0_default>;
    pinctrl-1     = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
    current-speed = <115200>;
};

/* Battery-rail ADC channel definition. The Pi-side firmware dumps
 * the raw 12-bit SAADC count to BLE; the host panel currently
 * displays it as `B: NNNN ADC` without a unit conversion.
 *
 * Hardware assumption: the kclock PCB carries a 1 MΩ / 510 KΩ
 * voltage divider on the battery rail, with the partitioned tap
 * tied to AIN7 (P0.31 / XIAO D7). That ratio is
 *   R_bottom / R_total = 510 / (1000 + 510) ≈ 0.337
 * so a single-cell LiPo running 3.0 V → 4.2 V maps to a tap voltage
 * of 1.01 V → 1.42 V.
 *
 * Scale choice on the nRF52840 SAADC: the hardware only has
 * reference selector bits for `Internal` (0.6 V bandgap) and
 * `VDD1/4`. Anything finer and Zephyr's nrfx-saadc adapter
 * returns -EINVAL. To widen effective full-scale beyond 0.825 V
 * we leverage the SAADC's gain register:
 *   gain     = ADC_GAIN_1_6  (enumeration position 0, hardware
 *                              register value 0 = factor 1/6)
 *   reference = ADC_REF_VDD_1_4 (Vref = VDD/4 = 0.825 V)
 *   full-scale = Vref / gain = 0.825 / (1/6) ≈ 4.95 V
 *
 * Companion GPIO pin: the divider's hi-leg is gated by a MOSFET
 * that's enabled by driving P0.14 to output-low (per the klock
 * schematic). Until we drive it low the divider's reference is
 * pulled to VDD via an internal path, and the SAADC sees 3.3 V
 * instead of 1.32 V — without dropping the throughput, code
 * saturates at 4095. The `bat_enable` gpio node below ties that
 * pin to the sensor layer; sensor.c drives it low before the
 * SAADC channel setup.
 */
&adc {
    #address-cells = <1>;
    #size-cells = <0>;

    channel@7 {
        reg = <7>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_VDD_1_4";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN7>;
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;
    };
};

/* Battery-divider enable: P0.14 is a digital control input on
 * the kclock PCB that gates the divider's hi-leg MOSFET. We
 * declare this node under a wrapper that's compatible
 * "gpio-leds", matching the pattern used by led0/led1/led2 in
 * xiao_ble_common.dtsi — but renamed to "bat_leds" so the
 * unused-but-required `&leds` label isn't needed (the board
 * DTS doesn't expose one).
 *
 * sensor.c drives the pin low at boot via
 *   GPIO_DT_SPEC_GET(DT_NODELABEL(bat_enable), gpios).
 */
/ {
    bat_leds {
        compatible = "gpio-leds";
        bat_enable: bat_enable_pin {
            gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
            label = "Battery divider enable";
        };
    };
};
