[Unit]
Description=Kitchen Clock — main unit Python app (Path A: fbdev renderer)
Documentation=https://github.com/anomalyco/kitchen-clock
After=bluetooth.target network-online.target
Wants=bluetooth.target network-online.target

[Service]
Type=simple
User=betocool
Group=betocool
WorkingDirectory=/opt/kitchen-clock

# Path A on the Pi: bypass SDL. SDL 2.32 on Trixie armv6 ships with
# no working video driver (kmsdrm needs GLES; fbcon isn't compiled
# in). FbdevRunner writes to /dev/fb0 via mmap and Pillow — same
# surface the kernel boot splash uses.
Environment=KITCHEN_CLOCK_RENDERER=fbdev
Environment=KITCHEN_CLOCK_BLE=live

# Idle at least 1s after a draw before yielding back to the loop.
# Useful signal if we ever want to debug latency; otherwise cosmetic.
ExecStart=/opt/kitchen-clock-venv/bin/python -m kitchen_clock --period 0.25

Restart=on-failure
RestartSec=5

# Hold a soft cap on memory: fbdev blits are CPU-only, so a Pillow
# font cache + a framebuffer image + a buffer should all fit under
# 64 MB resident. Triggered by systemd OOM-killer; only Relevant
# for nasty memory leaks.
MemoryHigh=80M
MemoryMax=160M

# Stdout/stderr go to the systemd journal. Previously had
# StandardOutput=tty; TTYPath=/dev/tty3 so runs landed on /dev/tty3
# (which kernel console=tty3 keeps for getty). That caused visible
# overlay text on the panel because the pyGame renderer writes to
# /dev/fb0 — a separate layer below tty3 on the KMS surface. The
# journal-based sink leaves the panel clean while preserving
# diagnostics via `journalctl -u kitchen-clock.service -f`.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
