/.vscode/
**/.west/
**/build/
**/__pycache__/

# Zephyr west workspace — the modules checked out by `west update`
# are not project source. They live under firmware/.west/config.
firmware/bootloader/
firmware/modules/
firmware/tools/
firmware/zephyr/

# Build outputs (sensor firmware .uf2 from scripts/build-sensor.sh).
/dist/

# Local diagnostic artifacts (panel screenshots for visual review).
/panel-snapshot*.png
/panel-snapshots/

# Secrets — never commit secrets.env (the SD-card provisioning
# loader; values are user-supplied). secrets.env.example is the
# placeholder version and IS committed.
/secrets.env
*.env.local
